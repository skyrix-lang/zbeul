# Copy to .env (`yarn setup` does, with a random SESSION_SECRET).

# The address people use. The OIDC callback, the CSRF check, canonical URLs and
# the sitemap are built from it. In development it's the Vite dev server.
PUBLIC_URL=http://localhost:3000

# Ports in development: Vite (WEB_PORT) forwards /api and /auth to the BFF
# (PORT). `yarn setup` sets both in a git worktree, so checkouts can run side by
# side; update PUBLIC_URL with WEB_PORT. In Docker, PORT is the container's port.
# WEB_PORT=3000
# PORT=3001

# The least severe level the BFF logs: debug, info, warn, error or silent.
# Lines are JSON when NODE_ENV=production (as in the image), text otherwise.
# LOG_LEVEL=info

# Postgres connection, matching `yarn db:up`.
DATABASE_URL=postgres://zbeul:zbeul@localhost:5432/zbeul

# Signs the short-lived sign-in cookie. At least 32 random characters in
# production: `openssl rand -base64 33`.
SESSION_SECRET=change-me

# The admin (the hidden /admin page): one account, which signs in with a
# password. The first time, whoever has the setup code chooses that password at
# /admin#code=<ADMIN_SETUP_CODE>; afterwards the code does nothing. Leave both
# unset for no admin at all. A code: `openssl rand -hex 24`.
# ADMIN_EMAIL=you@example.com
# ADMIN_SETUP_CODE=

# An identity provider, optional: any OpenID Connect provider, with a
# confidential client whose redirect URI is ${PUBLIC_URL}/auth/callback. All
# three or none. Production runs without one (the admin's password is the only
# sign-in); these match the local Keycloak from `yarn keycloak:up`
# (users ada / ada and grace / grace), which the e2e tests use.
OIDC_ISSUER=http://localhost:8180/realms/zbeul
OIDC_CLIENT_ID=zbeul-web
OIDC_CLIENT_SECRET=zbeul-web-dev-secret

# Mail (apps/bff/src/mail.ts). Leave SMTP_HOST unset and mail is only logged,
# never sent: tests always run that way. For Scaleway Transactional Email, the
# user is the project ID and the password an API secret key, and MAIL_FROM
# must be on a domain verified there. Port 465 or 2465 uses TLS from the
# start; 587, 2587 or 25 must upgrade with STARTTLS.
# SMTP_HOST=smtp.tem.scaleway.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Zbeul <no-reply@example.com>"

# Google Analytics 4 (docs/seo-and-analytics.md, "Analytics"). Unset, there is none: no script, no
# consent banner, nothing added to the CSP. Set, visitors are asked first, and
# Google's library loads only for those who accept.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Production (.env.production on the server, readable by its owner only; see
# "Deploying" in docs/deployment.md). The values above, for production, plus the
# proxy's: docker/compose.production.yaml runs behind nginx-proxy and its
# Let's Encrypt companion. DATABASE_URL then names the shared Postgres on the
# proxy's network, e.g. postgres://<user>:<password>@postgres:5432/<database>.
# The backups' R2 key goes in a separate backup.env, never here
# (docker/backup.env.example).
# VIRTUAL_HOST=app.example.com
# VIRTUAL_PORT=3000
# LETSENCRYPT_HOST=app.example.com
# LETSENCRYPT_EMAIL=you@example.com
