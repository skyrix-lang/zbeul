{
  "openapi": "3.1.0",
  "info": {
    "title": "Zbeul API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "isAdmin": {
                "type": "boolean"
              }
            },
            "required": [
              "email",
              "name",
              "isAdmin"
            ]
          }
        },
        "required": [
          "user"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateReport": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^[A-Z]+-[A-Z0-9]+$"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "default": ""
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "boring",
                "too-long",
                "too-hard",
                "to-fix"
              ]
            },
            "maxItems": 4,
            "default": []
          }
        }
      },
      "LikeCards": {
        "type": "object",
        "properties": {
          "cardIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^[A-Z]+-[A-Z0-9]+$"
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "cardIds"
        ]
      },
      "Deck": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "packs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "description"
              ]
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          }
        },
        "required": [
          "version",
          "packs",
          "cards"
        ]
      },
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[A-Z0-9]+$"
          },
          "game": {
            "type": "string",
            "enum": [
              "tu-preferes",
              "jamais",
              "action-verite",
              "qui-pourrait",
              "tribunal",
              "duel",
              "culture-g",
              "chaine",
              "valise",
              "montre-ou-bois",
              "tout-le-monde",
              "sentence",
              "regle",
              "partenaire",
              "pause"
            ]
          },
          "level": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  1
                ]
              },
              {
                "type": "number",
                "enum": [
                  2
                ]
              },
              {
                "type": "number",
                "enum": [
                  3
                ]
              },
              {
                "type": "number",
                "enum": [
                  4
                ]
              },
              {
                "type": "number",
                "enum": [
                  5
                ]
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "contact",
                "sexe",
                "ex",
                "couple",
                "argent",
                "avis",
                "secrets",
                "transgressions"
              ]
            }
          },
          "targets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "audience": {
            "type": "string",
            "enum": [
              "gars",
              "filles",
              "autres"
            ]
          },
          "doubleTier": {
            "type": "boolean"
          },
          "witness": {
            "type": "boolean"
          },
          "ruleDuration": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "pack": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "game",
          "level",
          "text",
          "themes",
          "targets"
        ]
      },
      "AdminStatus": {
        "type": "object",
        "properties": {
          "setupNeeded": {
            "type": "boolean"
          }
        },
        "required": [
          "setupNeeded"
        ]
      },
      "AdminSetup": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "maxLength": 200
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password",
          "code"
        ]
      },
      "AdminLogin": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Report": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cardId": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "boring",
                "too-long",
                "too-hard",
                "to-fix"
              ]
            }
          },
          "status": {
            "$ref": "#/components/schemas/ReportStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "cardId",
          "message",
          "reasons",
          "status",
          "createdAt"
        ]
      },
      "ReportStatus": {
        "type": "string",
        "enum": [
          "open",
          "handled",
          "dismissed"
        ]
      },
      "UpdateReport": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ReportStatus"
          }
        },
        "required": [
          "status"
        ]
      },
      "AdminCard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "game": {
            "type": "string",
            "enum": [
              "tu-preferes",
              "jamais",
              "action-verite",
              "qui-pourrait",
              "tribunal",
              "duel",
              "culture-g",
              "chaine",
              "valise",
              "montre-ou-bois",
              "tout-le-monde",
              "sentence",
              "regle",
              "partenaire",
              "pause"
            ]
          },
          "level": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  1
                ]
              },
              {
                "type": "number",
                "enum": [
                  2
                ]
              },
              {
                "type": "number",
                "enum": [
                  3
                ]
              },
              {
                "type": "number",
                "enum": [
                  4
                ]
              },
              {
                "type": "number",
                "enum": [
                  5
                ]
              }
            ]
          },
          "text": {
            "type": "string"
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "contact",
                "sexe",
                "ex",
                "couple",
                "argent",
                "avis",
                "secrets",
                "transgressions"
              ]
            }
          },
          "packId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          },
          "audience": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "gars",
              "filles",
              "autres",
              null
            ]
          },
          "doubleTier": {
            "type": "boolean"
          },
          "witness": {
            "type": "boolean"
          },
          "ruleDuration": {
            "type": [
              "integer",
              "null"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "likes": {
            "type": "integer"
          },
          "reports": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "game",
          "level",
          "text",
          "themes",
          "packId",
          "status",
          "audience",
          "doubleTier",
          "witness",
          "ruleDuration",
          "answer",
          "unit",
          "source",
          "updatedAt",
          "likes",
          "reports"
        ]
      },
      "CardInput": {
        "type": "object",
        "properties": {
          "game": {
            "type": "string",
            "enum": [
              "tu-preferes",
              "jamais",
              "action-verite",
              "qui-pourrait",
              "tribunal",
              "duel",
              "culture-g",
              "chaine",
              "valise",
              "montre-ou-bois",
              "tout-le-monde",
              "sentence",
              "regle",
              "partenaire",
              "pause"
            ]
          },
          "level": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  1
                ]
              },
              {
                "type": "number",
                "enum": [
                  2
                ]
              },
              {
                "type": "number",
                "enum": [
                  3
                ]
              },
              {
                "type": "number",
                "enum": [
                  4
                ]
              },
              {
                "type": "number",
                "enum": [
                  5
                ]
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 600
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "contact",
                "sexe",
                "ex",
                "couple",
                "argent",
                "avis",
                "secrets",
                "transgressions"
              ]
            },
            "default": []
          },
          "packId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "default": "draft"
          },
          "audience": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "gars",
              "filles",
              "autres",
              null
            ]
          },
          "doubleTier": {
            "type": "boolean",
            "default": false
          },
          "witness": {
            "type": "boolean",
            "default": false
          },
          "ruleDuration": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 50
          },
          "answer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        },
        "required": [
          "game",
          "level",
          "text",
          "packId"
        ]
      },
      "BulkCardsResult": {
        "type": "object",
        "properties": {
          "changed": {
            "type": "integer"
          }
        },
        "required": [
          "changed"
        ]
      },
      "BulkCards": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 30
            },
            "minItems": 1,
            "maxItems": 2000
          },
          "level": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  1
                ]
              },
              {
                "type": "number",
                "enum": [
                  2
                ]
              },
              {
                "type": "number",
                "enum": [
                  3
                ]
              },
              {
                "type": "number",
                "enum": [
                  4
                ]
              },
              {
                "type": "number",
                "enum": [
                  5
                ]
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          },
          "packId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "ids"
        ]
      },
      "CardChange": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cardId": {
            "type": "string"
          },
          "adminEmail": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "created",
              "updated"
            ]
          },
          "before": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {}
          },
          "after": {
            "type": "object",
            "additionalProperties": {}
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "cardId",
          "adminEmail",
          "action",
          "before",
          "after",
          "createdAt"
        ]
      },
      "Pack": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "published": {
            "type": "boolean"
          },
          "publishedCards": {
            "type": "integer"
          },
          "cards": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "published",
          "publishedCards",
          "cards"
        ]
      },
      "PackInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "default": ""
          },
          "published": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "name"
        ]
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "example": "09:30"
          },
          "duration": {
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "date",
          "time",
          "duration",
          "status"
        ]
      },
      "BookingStatus": {
        "type": "string",
        "enum": [
          "pending",
          "confirmed",
          "cancelled"
        ]
      },
      "CreateBooking": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "format": "time"
          },
          "duration": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1440
          }
        },
        "required": [
          "title",
          "date",
          "time",
          "duration"
        ]
      },
      "UpdateBooking": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The database answers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "It doesn't",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "The signed-in user, or null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "post": {
        "operationId": "createReport",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReport"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The report is recorded"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many reports from this address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/likes": {
      "post": {
        "operationId": "likeCards",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LikeCards"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The likes are counted"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many likes from this address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/deck": {
      "get": {
        "operationId": "getDeck",
        "responses": {
          "200": {
            "description": "The published cards of the published packs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deck"
                }
              }
            }
          },
          "304": {
            "description": "The deck the client already has is current"
          }
        }
      }
    },
    "/api/admin/status": {
      "get": {
        "operationId": "getAdminStatus",
        "responses": {
          "200": {
            "description": "Whether the admin still has to choose a password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/setup": {
      "post": {
        "operationId": "setUpAdmin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSetup"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The password is set, and the admin is signed in"
          },
          "400": {
            "description": "Invalid request, such as a weak password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Wrong email or code, or the password is already set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts from this address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/login": {
      "post": {
        "operationId": "logInAdmin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLogin"
              }
            }
          }
        },
        "responses": {
          "204": {
